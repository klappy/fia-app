{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fia.klappy.dev/contracts/c03-catalog-manifest.schema.json",
  "title": "Catalog manifest",
  "description": "Build-time index over every (language, pericope) pair: which resource types exist, bytes per tier, source revision, provenance counts (R-302, R-314). The app reads languages and coverage from here, never from code.",
  "version": "1.0.0",
  "contract": "c03",
  "type": "object",
  "required": [
    "schemaVersion",
    "builtAt",
    "appVersion",
    "languages",
    "entries"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "builtAt": {
      "type": "string",
      "format": "date-time"
    },
    "appVersion": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+\\+[a-f0-9]{7}$",
      "description": "semver + 7-char build sha, as in <meta name=\"fia-release\">"
    },
    "languages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "code",
          "autonym",
          "name",
          "direction"
        ],
        "additionalProperties": false,
        "properties": {
          "code": {
            "type": "string",
            "pattern": "^[a-z]{3}(-[A-Za-z]{2,8})?$",
            "description": "Aquifer language code: ISO 639-3 three letters (eng, spa, arb, hin, ...) or Aquifer's script-suffixed forms (zhs, zht); never a BCP-47 two-letter tag"
          },
          "autonym": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "direction": {
            "type": "string",
            "enum": [
              "ltr",
              "rtl"
            ]
          },
          "script": {
            "type": "string"
          }
        }
      }
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "packId",
          "language",
          "pericope",
          "book",
          "title",
          "resourceTypes",
          "tierBytes",
          "sourceRevision",
          "provenance",
          "manifestSha256"
        ],
        "additionalProperties": false,
        "properties": {
          "packId": {
            "type": "string",
            "pattern": "^[a-z]{3}(-[A-Za-z]{2,8})?\\.[1-3A-Z]{3}(-\\d{1,3}){2,4}$",
            "description": "<language>.<pericope>, e.g. spa.MRK-1-1-13"
          },
          "language": {
            "type": "string",
            "pattern": "^[a-z]{3}(-[A-Za-z]{2,8})?$",
            "description": "Aquifer language code: ISO 639-3 three letters (eng, spa, arb, hin, ...) or Aquifer's script-suffixed forms (zhs, zht); never a BCP-47 two-letter tag"
          },
          "pericope": {
            "type": "string",
            "pattern": "^[1-3A-Z]{3}(-\\d{1,3}){2,4}$",
            "description": "USFM book id + chapter/verse range, e.g. MRK-1-1-13 (book, c, v[, c, v])"
          },
          "book": {
            "type": "string",
            "pattern": "^[1-3A-Z]{3}$"
          },
          "title": {
            "type": "string"
          },
          "resourceTypes": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "guide",
                "scripture",
                "term",
                "image",
                "map",
                "video",
                "audio",
                "description"
              ]
            }
          },
          "tierBytes": {
            "type": "object",
            "required": [
              "text"
            ],
            "additionalProperties": false,
            "properties": {
              "text": {
                "type": "integer",
                "minimum": 0
              },
              "phone": {
                "type": "integer",
                "minimum": 0
              },
              "medium": {
                "type": "integer",
                "minimum": 0
              },
              "original": {
                "type": "integer",
                "minimum": 0
              }
            }
          },
          "sourceRevision": {
            "type": "string",
            "description": "sha256 over the pack's sourceRevisions map"
          },
          "provenance": {
            "$ref": "https://fia.klappy.dev/contracts/c06-provenance.schema.json#/$defs/counts"
          },
          "manifestSha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$",
            "description": "SHA-256 hex, lower-case"
          }
        }
      }
    }
  },
  "additionalProperties": false,
  "examples": [
    {
      "schemaVersion": 1,
      "builtAt": "2026-10-01T00:00:00Z",
      "appVersion": "0.2.0+abc1234",
      "languages": [
        {
          "code": "spa",
          "autonym": "Español",
          "name": "Spanish",
          "direction": "ltr"
        }
      ],
      "entries": [
        {
          "packId": "spa.MRK-1-1-13",
          "language": "spa",
          "pericope": "MRK-1-1-13",
          "book": "MRK",
          "title": "Marcos 1:1-13",
          "resourceTypes": [
            "guide",
            "scripture",
            "term",
            "image"
          ],
          "tierBytes": {
            "text": 1800000,
            "phone": 19000000
          },
          "sourceRevision": "c1fe6f27e9738434c644c625acb6efaab9d2b89c01204babc0bd98643176fc0e",
          "provenance": {
            "text": {
              "source": 117,
              "generated": 0,
              "missing": 0
            },
            "audio": {
              "source": 2,
              "generated": 115,
              "missing": 0
            },
            "description": {
              "source": 0,
              "generated": 8,
              "missing": 0
            }
          },
          "manifestSha256": "9287a51008bf6e9c94d8e12e1cbf1bd7abc3c9e985b808bfa23e15e6f19820a6"
        }
      ]
    }
  ]
}
