{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fia.klappy.dev/contracts/c13-rights-record.schema.json",
  "title": "Rights record",
  "description": "Per source: licence and adaptation notice verbatim, holder, url, metadata sha. Rendered per resource and on About/Rights; discrepancies preserved, never resolved by code (R-312).",
  "version": "1.0.0",
  "contract": "c13",
  "type": "object",
  "required": [
    "schemaVersion",
    "id",
    "collection",
    "revision",
    "licenseInfo",
    "holders",
    "metadataSha256"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]+@[a-f0-9]{7}$"
    },
    "collection": {
      "type": "string"
    },
    "revision": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$",
      "description": "git commit sha (40 hex)"
    },
    "licenseInfo": {
      "type": "string",
      "description": "verbatim license_info"
    },
    "adaptationNotice": {
      "type": "string",
      "description": "verbatim adaptation_notice"
    },
    "holders": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      },
      "description": "every holder string found, verbatim, even when they disagree"
    },
    "url": {
      "type": "string",
      "format": "uri"
    },
    "metadataSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$",
      "description": "SHA-256 hex, lower-case"
    },
    "discrepancies": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": false,
  "examples": [
    {
      "schemaVersion": 1,
      "id": "FIAMaps@7e56e7b",
      "collection": "FIAMaps",
      "revision": "7e56e7bc68d354a72b7a3e882beb78d5f084d7f5",
      "licenseInfo": "CC BY-SA 4.0",
      "adaptationNotice": "",
      "holders": [
        "Biblica",
        "Word Collective"
      ],
      "url": "https://github.com/BibleAquifer/FIAMaps",
      "metadataSha256": "b6c6a377ce2e249e4ea3b51f50e96ca2e01928d1caed56c844bcf193a4d296fb",
      "discrepancies": [
        "holder differs between metadata.json and license_info"
      ]
    }
  ]
}
