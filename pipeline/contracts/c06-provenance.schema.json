{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fia.klappy.dev/contracts/c06-provenance.schema.json",
  "title": "Provenance record",
  "description": "One vocabulary for text, audio and descriptions: source | generated | missing, with what it was generated from and the source collection + revision. UI renders user words, never backend names.",
  "version": "1.0.0",
  "contract": "c06",
  "type": "object",
  "required": [
    "status"
  ],
  "properties": {
    "status": {
      "type": "string",
      "enum": [
        "source",
        "generated",
        "missing"
      ]
    },
    "collection": {
      "type": "string",
      "description": "Aquifer collection name when status=source"
    },
    "revision": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$",
      "description": "git commit sha (40 hex)"
    },
    "generatedFrom": {
      "type": "string",
      "description": "<collection>@<sha>:<path>#<unit> when status=generated"
    },
    "generator": {
      "type": "string",
      "enum": [
        "translation",
        "narration",
        "description"
      ]
    },
    "audited": {
      "type": "boolean",
      "description": "native-speaker audition passed (R-510); absent = not yet heard"
    }
  },
  "additionalProperties": false,
  "examples": [
    {
      "status": "generated",
      "generatedFrom": "FIATranslationGuide@5d6d59a22caa8f8539c5ff6a3e1ec74c4cfa5c6d:eng/mark-1-1-13#S01-U001",
      "generator": "narration",
      "audited": false
    }
  ],
  "$defs": {
    "counts": {
      "type": "object",
      "required": [
        "text",
        "audio",
        "description"
      ],
      "additionalProperties": false,
      "properties": {
        "text": {
          "type": "object",
          "required": [
            "source",
            "generated",
            "missing"
          ],
          "additionalProperties": false,
          "properties": {
            "source": {
              "type": "integer",
              "minimum": 0
            },
            "generated": {
              "type": "integer",
              "minimum": 0
            },
            "missing": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "audio": {
          "type": "object",
          "required": [
            "source",
            "generated",
            "missing"
          ],
          "additionalProperties": false,
          "properties": {
            "source": {
              "type": "integer",
              "minimum": 0
            },
            "generated": {
              "type": "integer",
              "minimum": 0
            },
            "missing": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "description": {
          "type": "object",
          "required": [
            "source",
            "generated",
            "missing"
          ],
          "additionalProperties": false,
          "properties": {
            "source": {
              "type": "integer",
              "minimum": 0
            },
            "generated": {
              "type": "integer",
              "minimum": 0
            },
            "missing": {
              "type": "integer",
              "minimum": 0
            }
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "source"
          }
        }
      },
      "then": {
        "required": [
          "collection",
          "revision"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "generated"
          }
        }
      },
      "then": {
        "required": [
          "generatedFrom",
          "generator"
        ]
      }
    }
  ]
}
