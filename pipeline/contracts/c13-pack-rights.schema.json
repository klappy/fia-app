{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fia.klappy.dev/contracts/c13-pack-rights.schema.json",
  "title": "Pack rights lines",
  "description": "C-13 projection carried in each content pack as rights.json (BL8, F3a S15): one line per manifest.rights id with the holders, licence, url and discrepancies read from data/rights/records.json by pipeline/src/rights.mjs packRightsLines. Nothing is invented: a missing record, placeholder holder or absent licence is null; discrepancies are verbatim (R-312), [] when the record lists none, null when there is no record. 1.1.0: a line mirrors revisionKind and the widened revision exactly as c13-rights-record does (revisionKind absent = git → 40-hex; sha256 → 64-hex), and the record licenceUrl when it has one.",
  "version": "1.1.0",
  "contract": "c13",
  "type": "object",
  "required": ["schemaVersion", "packId", "source", "sources"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "packId": { "type": "string", "pattern": "^[a-z]{3}(-[A-Za-z]{2,8})?\\.[1-3A-Z]{3}(-\\d{1,3}){2,4}$", "description": "C-02 packId" },
    "source": { "type": "string", "description": "where the lines were read from (C-13 data/rights/records.json)" },
    "sources": {
      "type": "array",
      "items": { "$ref": "#/$defs/line" }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "line": {
      "type": "object",
      "required": ["id", "collection", "revision", "holders", "licence", "url", "discrepancies"],
      "properties": {
        "id": { "type": "string", "pattern": "^[A-Za-z0-9_-]+@[a-f0-9]{7}$", "description": "C-13 record id, equal to the manifest.rights entry" },
        "collection": { "type": "string" },
        "revisionKind": { "type": "string", "enum": ["git", "sha256"], "description": "C-13 revisionKind; absent = git" },
        "revision": { "type": ["string", "null"], "pattern": "^([a-f0-9]{40}|[a-f0-9]{64})$" },
        "holders": { "type": ["array", "null"], "minItems": 1, "items": { "type": "string" }, "description": "C-13 holders verbatim, placeholders removed" },
        "licence": {
          "type": ["object", "null"],
          "required": ["name", "url"],
          "properties": {
            "name": { "type": ["string", "null"] },
            "url": { "type": ["string", "null"] }
          },
          "additionalProperties": false
        },
        "licenceUrl": { "type": "string", "format": "uri", "description": "C-13 licenceUrl verbatim; absent when the record has none" },
        "url": { "type": ["string", "null"], "format": "uri" },
        "discrepancies": { "type": ["array", "null"], "items": { "type": "string" } }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": { "properties": { "revisionKind": { "const": "sha256" } }, "required": ["revisionKind"] },
          "then": { "properties": { "revision": { "pattern": "^[a-f0-9]{64}$" } } },
          "else": { "properties": { "revision": { "pattern": "^[a-f0-9]{40}$" } } }
        }
      ]
    }
  },
  "examples": [
    {
      "schemaVersion": 1,
      "packId": "eng.MRK-1-1-13",
      "source": "C-13 data/rights/records.json",
      "sources": [
        {
          "id": "FIAMaps@4bc9bb9",
          "collection": "FIAMaps",
          "revision": "4bc9bb9f1d9082e5d71a047a35bf8e608f473602",
          "holders": ["Biblica", "Word Collective", "Mission Mutual"],
          "licence": { "name": "CC BY-SA 4.0 license", "url": "https://creativecommons.org/licenses/by-sa/4.0/legalcode.en" },
          "url": "https://github.com/BibleAquifer/FIAMaps",
          "discrepancies": ["holder differs between license_info (\"Biblica\") and adaptation_notice (\"Word Collective\")"]
        },
        { "id": "SomeBible@abcdef1", "collection": "SomeBible", "revision": null, "holders": null, "licence": null, "url": null, "discrepancies": null }
      ]
    }
  ]
}
