\v 6 \w Ellos|strong="G3588"\w* contestaron \w lo|strong="G3588"\w* \w que|strong="G3588"\w* \w Jesús|strong="G2424"\w* \w dijo|strong="G3004"\w*, \w y|strong="G2532"\w* \w los|strong="G3588"\w* dejaron.   
\p
\v 7 Llevaron \w el|strong="G3588"\w* \w pollino|strong="G4454"\w* \w a|strong="G4314"\w* \w Jesús|strong="G2424"\w*, \w sobre|strong="G1909"\w* \w el|strong="G3588"\w* \w cual|strong="G3588"\w* \w echaron|strong="G1911"\w* \w sus|strong="G3588"\w* \w ropas|strong="G2440"\w*, \w y|strong="G2532"\w* \w Él|strong="G3588"\w* montó.   
\p
\v 8 \w Muchos|strong="G4183"\w* \w también|strong="G2532"\w* extendieron \w sus|strong="G3588"\w* \w ropas|strong="G2440"\w* \w por|strong="G1537"\w* \w el|strong="G3588"\w* \w camino|strong="G3598"\w*, \w y|strong="G2532"\w* \w otros|strong="G3588"\w*, ramas \w que|strong="G3588"\w* cortaron \w de|strong="G1537"\w* \w los|strong="G3588"\w* campos.  
\v 9 \w Los|strong="G3588"\w* \w que|strong="G3588"\w* iban adelante \w y|strong="G2532"\w* \w los|strong="G3588"\w* \w que|strong="G3588"\w* \add lo\add* seguían \w aclamaban|strong="G2896"\w*:  
\m ¡\w Hosanna|strong="G5614"\w*! ¡\w Bendito|strong="G2127"\w* \w el|strong="G3588"\w* \w que|strong="G3588"\w* \w viene|strong="G2064"\w* \w en|strong="G1722"\w* \w Nombre|strong="G3686"\w* \w del|strong="G3588"\w* \w Señor|strong="G2962"\w*!   
\m
\v 10 ¡\w Bendito|strong="G2127"\w* \w el|strong="G3588"\w* reino \w de|strong="G1722"\w* \w nuestro|strong="G2249"\w* antepasado \w David|strong="G1138"\w* \w que|strong="G3588"\w* \w viene|strong="G2064"\w*!  
\m ¡\w Hosanna|strong="G5614"\w* \w en|strong="G1722"\w* \w las|strong="G3588"\w* \w alturas|strong="G5310"\w*!   
\s1 Entrada de Jesús al Santuario  
\p
\v 11 \add Jesús\add* \w entró|strong="G1525"\w* \w al|strong="G3588"\w* \w Santuario|strong="G2411"\w* \w en|strong="G1519"\w* Jerusalén \w y|strong="G2532"\w* echó \w una|strong="G3588"\w* mirada \w a|strong="G1519"\w* \w su|strong="G3588"\w* alrededor. \w Como|strong="G2532"\w* \w la|strong="G3588"\w* \w hora|strong="G5610"\w* \w era|strong="G1519"\w* avanzada, \w salió|strong="G1831"\w* \w a|strong="G1519"\w* Betania \w con|strong="G3326"\w* \w los|strong="G3588"\w* 12.   
\s1 Una higuera estéril  
\p
\v 12 \w Al|strong="G3588"\w* día \w siguiente|strong="G1887"\w*, cuando \w salieron|strong="G1831"\w* \w de|strong="G3588"\w* Betania, \add Jesús\add* tuvo \w hambre|strong="G3983"\w*.  
