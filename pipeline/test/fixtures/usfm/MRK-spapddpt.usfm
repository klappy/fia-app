\v 25 \wj \+w Cuando|strong="G3752"\+w* perseveren \+w en|strong="G1722"\+w* \+w la|strong="G3588"\+w* conversación \+w con|strong="G1722"\+w* Dios, \+w si|strong="G1487"\+w* \+w tienen|strong="G2192"\+w* \+w algo|strong="G5100"\+w* \+w contra|strong="G2596"\+w* \+w alguien|strong="G5100"\+w*, perdonen, \+w para|strong="G2443"\+w* \+w que|strong="G3588"\+w* \+w también|strong="G2532"\+w* \+w su|strong="G3588"\+w* \+w Padre|strong="G3962"\+w* celestial les perdone \+w sus|strong="G3588"\+w* transgresiones.\wj* [[ 
\v 26 ]]   
\s1 ¿Con qué autoridad?  
\p
\v 27 \w Volvieron|strong="G3825"\w* \w a|strong="G1519"\w* Jerusalén. \w Cuando|strong="G1722"\w* \add Jesús\add* caminaba \w en|strong="G1722"\w* \w el|strong="G3588"\w* \w Santuario|strong="G2411"\w* \w se|strong="G4314"\w* \w le|strong="G4314"\w* acercaron \w los|strong="G3588"\w* principales sacerdotes, \w los|strong="G3588"\w* \w escribas|strong="G1122"\w* \w y|strong="G2532"\w* \w los|strong="G3588"\w* \w ancianos|strong="G4245"\w*.   
\p
\v 28 \w Le|strong="G1722"\w* preguntaron: ¿\w Con|strong="G1722"\w* \w cuál|strong="G5101"\w* \w autoridad|strong="G1849"\w* \w haces|strong="G4160"\w* \w estas|strong="G3778"\w* cosas? ¿\w Quién|strong="G5101"\w* \w te|strong="G4771"\w* \w dio|strong="G1325"\w* \w la|strong="G3588"\w* \w autoridad|strong="G1849"\w* \w para|strong="G2443"\w* hacerlas?   
\p
\v 29 \w Entonces|strong="G1161"\w* \w Jesús|strong="G2424"\w* les respondió: \wj Les \+w pregunto|strong="G1905"\+w* \+w un|strong="G1520"\+w* asunto. Respóndanme \+w y|strong="G2532"\+w* \+w también|strong="G2532"\+w* les \+w diré|strong="G2046"\+w* \+w con|strong="G1722"\+w* \+w cuál|strong="G4169"\+w* \+w autoridad|strong="G1849"\+w* \+w hago|strong="G4160"\+w* \+w estas|strong="G3778"\+w* cosas: \wj*  
\v 30 \wj \+w El|strong="G3588"\+w* bautismo \+w de|strong="G1537"\+w* \+w Juan|strong="G2491"\+w*, ¿\+w era|strong="G1510"\+w* \+w del|strong="G3588"\+w* \+w cielo|strong="G3772"\+w* \+w o|strong="G2228"\+w* \+w de|strong="G1537"\+w* \+w los|strong="G3588"\+w* hombres? Contéstenme.\wj*   
\p
\v 31 Consultaban \w entre|strong="G4314"\w* \w ellos|strong="G1537"\w*: \w Si|strong="G1437"\w* \w decimos|strong="G3004"\w* \w del|strong="G1537"\w* \w cielo|strong="G3772"\w*, \add Él\add* \w dirá|strong="G2046"\w*: ¿\w Por|strong="G1223"\w* \w qué|strong="G5101"\w* \w no|strong="G3756"\w* \w le|strong="G4314"\w* \w creyeron|strong="G4100"\w*?  
\v 32 \w Pero|strong="G1063"\w*, ¿si \w decimos|strong="G3004"\w*: \w De|strong="G1537"\w* hombres...? \w Temían|strong="G5399"\w* \w a|strong="G1537"\w* \w la|strong="G3588"\w* \w multitud|strong="G3793"\w*, \w porque|strong="G1063"\w* todos creían \w que|strong="G3754"\w* \w Juan|strong="G2491"\w* \w era|strong="G2192"\w* realmente \w un|strong="G3588"\w* \w profeta|strong="G4396"\w*.   
\p
\v 33 Respondieron: \w No|strong="G3756"\w* \w sabemos|strong="G1492"\w*.  
\p \w Y|strong="G2532"\w* \w Jesús|strong="G2424"\w* les \w dijo|strong="G3004"\w*: \wj \+w Tampoco|strong="G3761"\+w* \+w Yo|strong="G1473"\+w* les \+w digo|strong="G3004"\+w* \+w con|strong="G1722"\+w* \+w cuál|strong="G4169"\+w* \+w autoridad|strong="G1849"\+w* \+w hago|strong="G4160"\+w* \+w estas|strong="G3778"\+w* cosas.\wj*   
