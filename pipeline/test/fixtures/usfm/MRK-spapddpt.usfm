\v 14 \w Entonces|strong="G2532"\w* Jesús \w dijo|strong="G3004"\w* \add a la higuera\add*: \wj ¡\+w De|strong="G1537"\+w* ahora \+w en|strong="G1519"\+w* adelante \+w para|strong="G1519"\+w* \+w siempre|strong="G3588"\+w*, \+w nadie|strong="G3367"\+w* \+w coma|strong="G2068"\+w* \+w fruto|strong="G2590"\+w* \+w de|strong="G1537"\+w* ti!\wj*  
\p \w Y|strong="G2532"\w* \w sus|strong="G3588"\w* \w discípulos|strong="G3101"\w* escuchaban.   
\s1 Purificación del Templo  
\p
\v 15 \w Volvieron|strong="G2064"\w* \w a|strong="G1519"\w* Jerusalén. \w Entró|strong="G1525"\w* \w en|strong="G1722"\w* \w el|strong="G3588"\w* \w Santuario|strong="G2411"\w* \w y|strong="G2532"\w* \w echó|strong="G1544"\w* \w a|strong="G1519"\w* \w los|strong="G3588"\w* \w que|strong="G3588"\w* \w vendían|strong="G4453"\w* \w y|strong="G2532"\w* compraban \w allí|strong="G1722"\w*. Volcó \w las|strong="G3588"\w* \w mesas|strong="G5132"\w* \w de|strong="G1722"\w* \w los|strong="G3588"\w* \w cambistas|strong="G2855"\w* \w y|strong="G2532"\w* \w los|strong="G3588"\w* asientos \w de|strong="G1722"\w* \w los|strong="G3588"\w* \w que|strong="G3588"\w* \w vendían|strong="G4453"\w* \w palomas|strong="G4058"\w*.  
\v 16 \w No|strong="G3756"\w* permitía \w que|strong="G3588"\w* llevaran objetos \w a|strong="G2443"\w* través \w del|strong="G3588"\w* \w Templo|strong="G2411"\w*.  
\v 17 Les \w enseñaba|strong="G1321"\w*: \wj ¿\+w No|strong="G3756"\+w* \+w está|strong="G3588"\+w* \+w escrito|strong="G1125"\+w*: \wj*  
\m \wj \+w Mi|strong="G3588"\+w* \+w Casa|strong="G3624"\+w* será \+w llamada|strong="G2564"\+w* \+w Casa|strong="G3624"\+w* \+w de|strong="G3588"\+w* conversación \+w con|strong="G2532"\+w* Dios para \+w todas|strong="G3956"\+w* \+w las|strong="G3588"\+w* \+w naciones|strong="G1484"\+w*? \wj*  
\p \wj \+w Pero|strong="G1161"\+w* ustedes \+w la|strong="G3588"\+w* convirtieron \+w en|strong="G3588"\+w* \wj*  
\m \wj \+w una|strong="G3588"\+w* \+w cueva|strong="G4693"\+w* \+w de|strong="G3588"\+w* \+w ladrones|strong="G3027"\+w*.\wj*   
\p
\v 18 \w Los|strong="G3588"\w* sumos sacerdotes \w y|strong="G2532"\w* \w los|strong="G3588"\w* \w escribas|strong="G1122"\w* oyeron \w a|strong="G1909"\w* Jesús, \w y|strong="G2532"\w* \w buscaban|strong="G2212"\w* \w la|strong="G3588"\w* manera \w de|strong="G1909"\w* matarlo, \w pero|strong="G2532"\w* tenían \w miedo|strong="G5399"\w* \w porque|strong="G1063"\w* \w la|strong="G3588"\w* \w multitud|strong="G3793"\w* estaba maravillada \w de|strong="G1909"\w* \w su|strong="G3588"\w* enseñanza.   
\p
\v 19 \w Al|strong="G3588"\w* atardecer salieron \w de|strong="G3588"\w* \w la|strong="G3588"\w* \w ciudad|strong="G4172"\w*.   
