\p
\v 40  \add One day\add* \w a|strong="G2532"\w* man \w who|strong="G3748"\w* \w had|strong="G2532"\w* \add a bad skin disease called\add* leprosy \w came|strong="G2064"\w* \w to|strong="G4314"\w* \w Jesus|strong="G3004"\w*. \w He|strong="G2532"\w* \w knelt|strong="G1120"\w* \w down|strong="G1120"\w* \w in|strong="G2532"\w* front \w of|strong="G2532"\w* \w Jesus|strong="G3004"\w* \w and|strong="G2532"\w* \w then|strong="G2532"\w* \w he|strong="G2532"\w* \w pleaded|strong="G3870"\w* \w with|strong="G4314"\w* \w him|strong="G2532"\w* \w saying|strong="G3004"\w*, “\add Please heal me, because I know\add* \w you|strong="G1437"\w* \w are|strong="G2532"\w* \w able|strong="G1410"\w* \w to|strong="G4314"\w* heal \w me|strong="G1473"\w* \w if|strong="G1437"\w* \w you|strong="G1437"\w* \w want|strong="G2309"\w* \w to|strong="G4314"\w*!”  
