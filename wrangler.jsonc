{
  // Cloudflare Workers static assets for the Alpha PWA (R-708). Captain ruling: domain
  // fiaguide.app, three environments. Workers Builds deploys with
  //   npx wrangler deploy --env dev         (branch main)       -> dev.fiaguide.app
  //   npx wrangler deploy --env staging     (branch staging)    -> staging.fiaguide.app
  //   npx wrangler deploy --env production  (branch production) -> fiaguide.app
  // Custom domains are attached account-side (Otto); no routes live in this file.
  // Build command: `npm run build` = `vite build` only — tests gate the PR in CI, never the build.
  // No LLM secret here: this Worker serves static assets only. The BL4c text route key (ANTHROPIC_API_KEY)
  // lives in CI secrets now and, once the API+MCP server Worker exists, on that Worker via
  // `wrangler secret put ANTHROPIC_API_KEY` (host only; never in this file or vars).
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "fia-app",
  "compatibility_date": "2026-09-01",
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "html_handling": "auto-trailing-slash",
  },
  "observability": { "enabled": true },
  "env": {
    "dev": { "name": "fia-app-dev" },
    "staging": { "name": "fia-app-staging" },
    "production": { "name": "fia-app" },
  },
}
