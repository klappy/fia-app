{
  // Cloudflare Workers static assets for the Alpha PWA (R-708). Captain ruling: domain
  // fiaguide.app, three environments. Workers Builds deploys with
  //   npx wrangler deploy --env dev         (branch main)       -> dev.fiaguide.app
  //   npx wrangler deploy --env staging     (branch staging)    -> staging.fiaguide.app
  //   npx wrangler deploy --env production  (branch production) -> fiaguide.app
  // Custom domains are attached account-side (Otto); no routes live in this file.
  // Build command: `npm run build` = Vite, offline finalization and the pinned read bundle — tests gate the PR in CI, never the build.
  // Static assets, read HTTP/MCP and bounded preparation metadata; no provider calls.
  // Existing Workers and domains remain unchanged.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "fia-app",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "main": "server/faces/worker/entry.mjs",
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/v1", "/v1/*", "/mcp", "/mcp/*"],
    "not_found_handling": "single-page-application",
    "html_handling": "auto-trailing-slash",
  },
  "observability": { "enabled": true },
  // Preparation storage and migration are DEV-only. No default/staging/production activation.
  "env": {
    "dev": { "migrations": [{ "tag": "v1-preparation", "new_sqlite_classes": ["FiaPreparationJobs"] }], "r2_buckets": [{ "binding": "FIA_ORIGINALS", "bucket_name": "fia-originals-development" }], "durable_objects": { "bindings": [{ "name": "FIA_PREPARATION_JOBS", "class_name": "FiaPreparationJobs" }] }, "name": "fia-app-dev", "vars": { "FIA_API_ORIGIN": "https://dev.fiaguide.app" } },
    "staging": { "name": "fia-app-staging", "vars": { "FIA_API_ORIGIN": "https://staging.fiaguide.app" } },
    "production": { "name": "fia-app", "vars": { "FIA_API_ORIGIN": "https://fiaguide.app" } },
  },
}
