    "units": [
      {
        "activityId": "S01-U001",
        "sourceUnitId": "S01-U001",
        "sourceTextSha256": "f7e2326c06e5dbaa0c411011ff8c9140874ce66fae975b81cf8f5652bf7e3c0e",
        "text": "In this step, hear Mark 1:21\u201328 and put it in your hearts."
      },
      {
        "activityId": "S01-U002",
        "sourceUnitId": "S01-U002",
        "sourceTextSha256": "b4aff5c9328cf18862706ebca2a8cfc8dfc006738aeaeaf939759f86e31a8ba8",
        "text": "Listen to an audio version of Mark 1:21\u201328 three times, in three different translations, if possible. Then, as a group, discuss the following questions:"
      },
      {
        "activityId": "S01-U003",
        "sourceUnitId": "S01-U003",
        "sourceTextSha256": "c6ef6ed4d31b97cf4a0d03a8228505d052a8a780a5fe0413ebc441860df97b5d",
        "text": "What do you like in this passage?"
      },
      {
        "activityId": "S01-U004",
        "sourceUnitId": "S01-U004",
        "sourceTextSha256": "e8a93c2c61fe1a0f6f81fa58997b305e6fc98309b710e3a31ff8334e8644a3eb",
        "text": "What do you not like or not understand in this passage?"
      },
      {
        "activityId": "S01-U005",
        "sourceUnitId": "S01-U005",
        "sourceTextSha256": "5df74ebc5c4225c3d54e1629cff92f39a1cc058f2ac30b59d75d68d496d1d0f5",
        "text": "What does this passage tell us about Jesus?"
      },
      {
        "activityId": "S01-U006",
        "sourceUnitId": "S01-U006",
        "sourceTextSha256": "5ec46dee57eb35404b2cea3f9aaa67f2973ac8781088fa05d8073f9e72fdf4c3",
        "text": "What does this passage tell us about people?"
      },
      {
        "activityId": "S01-U007",
        "sourceUnitId": "S01-U007",
        "sourceTextSha256": "97dd8ff3c182bdac8fd7e57ffe1bf62350452bd66178db6560b7909eb5237842",
        "text": "How does this passage affect our daily lives?"
      },
      {
        "activityId": "S01-U008",
        "sourceUnitId": "S01-U008",
        "sourceTextSha256": "d7a5f7f06349c901d886647055b1f48f7251a9fbfe2b37e509b26e0538704e46",
        "text": "Who do you know who needs to hear this passage?"
      }
    ]
  },
