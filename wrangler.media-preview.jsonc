{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "fia-media-sequence-preview",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "main": "server/faces/worker/entry.mjs",
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/v1", "/v1/*", "/mcp", "/mcp/*", "/.well-known/oauth-authorization-server", "/.well-known/oauth-authorization-server/*", "/.well-known/oauth-protected-resource", "/.well-known/oauth-protected-resource/*", "/.well-known/openid-configuration", "/.well-known/openid-configuration/*"],
    "not_found_handling": "single-page-application",
    "html_handling": "auto-trailing-slash"
  },
  "vars": { "FIA_API_ORIGIN": "https://fia-media-sequence-preview.klappy.workers.dev" }
}
