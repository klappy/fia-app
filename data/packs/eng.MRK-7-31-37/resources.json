    {
      "id": "term-eng-t35",
      "termNumber": "35",
      "engSourceId": "eng-t35-v1",
      "title": "Decapolis",
      "sourceFile": "eng/json/004.content.json",
      "selectedBy": "passage",
      "text": {
        "status": "source",
        "sourceId": "eng-t35-v1",
        "html": "<p><b>Decapolis</b> literally means \"10 cities.\" The word refers to an area east of the <data class=\"resource-ref\" data-content-id=\"eng-t121-v1\" data-resource-code=\"FIAKeyTerms\">Sea of Galilee</data> and the <data class=\"resource-ref\" data-content-id=\"eng-t80-v1\" data-resource-code=\"FIAKeyTerms\">Jordan river</data>. Most people that lived there were not <data class=\"resource-ref\" data-content-id=\"eng-t77-v2\" data-resource-code=\"FIAKeyTerms\">Jews</data>.</p>",
        "textSha256": "507ec48ccc3c0b7ed05642ee61ec8ea7f4ab7a606dfe6b9a23fdd36bc4bf40c6",
        "provenance": {
          "status": "source",
          "collection": "FIAKeyTerms",
          "revision": "a39260670bba9d87d902e0fa0ae447341343481f"
        }
      },
