    {
      "id": "term-eng-t27",
      "termNumber": "27",
      "engSourceId": "eng-t27-v1",
      "title": "cloak",
      "sourceFile": "eng/json/003.content.json",
      "selectedBy": "passage",
      "text": {
        "status": "source",
        "sourceId": "eng-t27-v1",
        "html": "<p>A <b>cloak</b>, which is also called a <data class=\"resource-ref\" data-content-id=\"eng-t112-v1\" data-resource-code=\"FIAKeyTerms\">robe</data>, is a piece of clothing. People wear a cloak on top of other clothes. A cloak helps to keep people warm and dry and can be used as a blanket at night. People made cloaks from animal skin or wool. Wool is the hair of an animal called a sheep. A cloak was often a simple square piece of material with holes for the arms.</p><div data-type=\"callout\" data-callout-style=\"action\"><p>You can look in the visual dictionary for a picture of a cloak.</p></div>",
        "textSha256": "b352483d61c75bbc3d085bff0c90c53fcd18be05c5c3c60492e2e7f25dc84f32",
        "provenance": {
          "status": "source",
