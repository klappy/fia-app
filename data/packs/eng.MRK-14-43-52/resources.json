    {
      "id": "term-eng-t106",
      "termNumber": "106",
      "engSourceId": "eng-t106-v1",
      "title": "rabbi",
      "sourceFile": "eng/json/017.content.json",
      "selectedBy": "passage",
      "text": {
        "status": "source",
        "sourceId": "eng-t106-v1",
        "html": "<p><b>Rabbi</b> is a name that people in <data class=\"resource-ref\" data-content-id=\"eng-t74-v2\" data-resource-code=\"FIAKeyTerms\">Israel</data> gave a religious <data class=\"resource-ref\" data-content-id=\"eng-t136-v1\" data-resource-code=\"FIAKeyTerms\">teacher</data>. In their language the word means \"my great one,\" or \"my great teacher.\" When someone calls another person \"Rabbi,\" they are giving that person respect. Some translations keep the word \"Rabbi,\" and other translations just say \"teacher.\"</p><p><strong>When you are translating Rabbi, be careful about the following things:</strong></p><p>You can use a word or phrase in your language that means \"teacher.\" But the word should not be a word that is only used for a teacher of children in a school.</p>",
        "textSha256": "7fab67adcfe821703033cba4448a4512b0c570c09879f4fcf8d4dca4479a2df1",
        "provenance": {
