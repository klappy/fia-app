    {
      "id": "term-spa-t15",
      "termNumber": "15",
      "engSourceId": "eng-t15-v1",
      "title": "blasphemy",
      "sourceFile": "eng/json/002.content.json",
      "selectedBy": "passage",
      "text": {
        "status": "source",
        "sourceId": "spa-t15-v1",
        "html": "<p><b>Blasfemar</b> a alguien significa hablar <data class=\"resource-ref\" data-content-id=\"spa-t187-v1\" data-resource-code=\"FIAKeyTerms\">mal</data> de una persona, e insultar a alguien. Una persona que <data class=\"resource-ref\" data-content-id=\"spa-t31-v1\" data-resource-code=\"FIAKeyTerms\">maldice</data> a Dios, insulta a Dios, deshonra a Dios, o hace que Dios parezca menos poderoso o importante, está blasfemando contra Dios. El castigo por la blasfemia era la muerte.</p>",
        "textSha256": "e489389557298d52a25319d8767166d46fbf660f731ef9a8477e43146973d184",
        "provenance": {
          "status": "source",
