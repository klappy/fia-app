    {
      "id": "term-eng-t40",
      "termNumber": "40",
      "engSourceId": "eng-t40-v1",
      "title": "divorce",
      "sourceFile": "eng/json/004.content.json",
      "selectedBy": "passage",
      "text": {
        "status": "source",
        "sourceId": "eng-t40-v1",
        "html": "<p><b>Divorce</b> is a permanent and legal separation between a husband and wife. In the Old Testament, the <data class=\"resource-ref\" data-content-id=\"eng-t83-v1\" data-resource-code=\"FIAKeyTerms\">law</data> of God allowed a man to divorce his wife if he thought she had a relationship with another man. However, God makes clear that he hates divorce. God wants husband and wife to live together in harmony and to be dedicated to each other.</p><p>In the New Testament, Jesus also teaches the people that divorce is wrong. God meant for husband and wife to live together in unity.</p>",
        "textSha256": "7ebef5f242b35c07b76efddf8ae369889a5f423eb832d233f522a5ee78adb634",
        "provenance": {
          "status": "source",
