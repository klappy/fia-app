    {
      "id": "term-spa-t71",
      "termNumber": "71",
      "engSourceId": "eng-t71-v1",
      "title": "hypocrisy",
      "sourceFile": "eng/json/008.content.json",
      "selectedBy": "passage",
      "text": {
        "status": "source",
        "sourceId": "spa-t71-v1",
        "html": "<p><b>Hipocresía</b> significa que alguien finge ser bueno, pero en realidad no lo es. Una persona que les dice a los demás que es importante hacer ciertas cosas, pero que no las hace él mismo, es un hipócrita. Una persona que enseña a otras sobre la <data class=\"resource-ref\" data-content-id=\"spa-t83-v1\" data-resource-code=\"FIAKeyTerms\">ley</data> de Dios, pero que rompe la ley de Dios él mismo, es un hipócrita. Alguien que tiene malos pensamientos pero que hace cosas buenas solo porque quiere que otras personas lo alaben, es un hipócrita. Un hipócrita no es sincero. Él solo quiere verse bien a los ojos de las personas, pero realmente no le importa obedecer a Dios. </p>",
        "textSha256": "9fdaa58909e663bfc6cdc71df9713c4fda9a84457c62bf3aa2132c0be6312ebc",
        "provenance": {
          "status": "source",
          "collection": "FIAKeyTerms",
          "revision": "a39260670bba9d87d902e0fa0ae447341343481f"
        }
      },
