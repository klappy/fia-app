  "terms": [
    {
      "id": "term-spa-t19",
      "termNumber": "19",
      "engSourceId": "eng-t19-v1",
      "title": "caesar",
      "sourceFile": "eng/json/003.content.json",
      "selectedBy": "passage",
      "text": {
        "status": "source",
        "sourceId": "spa-t19-v1",
        "html": "<p><b>César</b> es el título para el emperador romano. Roma es una ciudad en el país llamado Italia. En la época del Nuevo Testamento, Roma era la capital del imperio romano.</p><p>Un imperio es un grupo de <data class=\"resource-ref\" data-content-id=\"spa-t94-v1\" data-resource-code=\"FIAKeyTerms\">naciones</data> o países que son gobernados por una persona o un gobierno. El líder de un imperio se llama de emperador. El emperador de los romanos se llamaba César.</p><p>El Imperio Romano incluía muchos países y grupos de personas. El Imperio Romano era muy grande. Las personas en todos esos países tenían que pagar impuestos al César. El César era tan poderoso que muchas personas lo trataban como a un dios. En algunas ciudades, las personas construían <data class=\"resource-ref\" data-content-id=\"spa-t138-v1\" data-resource-code=\"FIAKeyTerms\">templos</data> donde <data class=\"resource-ref\" data-content-id=\"spa-t149-v1\" data-resource-code=\"FIAKeyTerms\">adoraban</data> estatuas del César.</p>",
        "textSha256": "1b73044da5af8803a1917f470c256f8ba89177b69e3d3e34aae322ff3e8a3247",
        "provenance": {
          "status": "source",
          "collection": "FIAKeyTerms",
          "revision": "a39260670bba9d87d902e0fa0ae447341343481f"
        }
      },
