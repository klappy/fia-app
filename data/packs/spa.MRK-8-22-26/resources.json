    {
      "id": "term-spa-t14",
      "termNumber": "14",
      "engSourceId": "eng-t14-v1",
      "title": "bethsaida",
      "sourceFile": "eng/json/002.content.json",
      "selectedBy": "passage",
      "text": {
        "status": "source",
        "sourceId": "spa-t14-v1",
        "html": "<p><b>Betsaida</b> es un pueblo en la provincia de <data class=\"resource-ref\" data-content-id=\"spa-t55-v1\" data-resource-code=\"FIAKeyTerms\">Galilea</data>. Probablemente era cerca de la ciudad de <data class=\"resource-ref\" data-content-id=\"spa-t22-v1\" data-resource-code=\"FIAKeyTerms\">Cafarnaúm</data>, porque <data class=\"resource-ref\" data-content-id=\"spa-t78-v1\" data-resource-code=\"FIAKeyTerms\">Juan</data> nos dice que los <data class=\"resource-ref\" data-content-id=\"spa-t39-v1\" data-resource-code=\"FIAKeyTerms\">discípulos</data> de Jesús, Andrés y Pedro, venían de Betsaida, pero Marcos nos dice que vivían en Cafarnaúm. El pueblo estaba cerca del <data class=\"resource-ref\" data-content-id=\"spa-t121-v1\" data-resource-code=\"FIAKeyTerms\">Mar de Galilea</data>, y muchas personas en el pueblo se ganaban la vida de la pesca. El nombre Betsaida incluso significa “casa de pesca”.</p>",
        "textSha256": "3287505bc3ef7538b1052e7d5edb6b293a1522415e98a2f77e808ef8ddc3f13e",
        "provenance": {
          "status": "source",
          "collection": "FIAKeyTerms",
          "revision": "a39260670bba9d87d902e0fa0ae447341343481f"
        }
      },
      "audio": {
