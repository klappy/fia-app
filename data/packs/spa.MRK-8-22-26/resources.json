    },
    {
      "id": "term-spa-t62",
      "termNumber": "62",
      "engSourceId": "eng-t62-v1",
      "title": "heal",
      "sourceFile": "eng/json/008.content.json",
      "selectedBy": "passage",
      "text": {
        "status": "source",
        "sourceId": "spa-t62-v1",
        "html": "<p>En este tipo de sanación, Jesús <b>sana</b> a la persona tanto física como espiritualmente, restaurándola a la comunidad. La persona ha sido restaurada por completo o completamente. </p>",
        "textSha256": "9bf7ca78260a1f3963f99d119d5129317bd521ce1a03321ae2e4eb133f5b5cb9",
