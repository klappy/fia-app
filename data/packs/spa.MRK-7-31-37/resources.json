    {
      "id": "term-spa-t35",
      "termNumber": "35",
      "engSourceId": "eng-t35-v1",
      "title": "decapolis",
      "sourceFile": "eng/json/004.content.json",
      "selectedBy": "passage",
      "text": {
        "status": "source",
        "sourceId": "spa-t35-v1",
        "html": "<p><b>Decápolis</b> significa literalmente “10 ciudades”. La palabra se refiere a un área al este del <data class=\"resource-ref\" data-content-id=\"spa-t121-v1\" data-resource-code=\"FIAKeyTerms\">Mar de Galilea</data> y del <data class=\"resource-ref\" data-content-id=\"spa-t80-v1\" data-resource-code=\"FIAKeyTerms\">río Jordán</data>. La mayoría de las personas que vivían allí no eran <data class=\"resource-ref\" data-content-id=\"spa-t77-v2\" data-resource-code=\"FIAKeyTerms\">judíos</data>.</p>",
        "textSha256": "81f0f99c4a575058bb3e1210f294df3eb081c29a7740a93928720e9cfdb00fe2",
        "provenance": {
          "status": "source",
          "collection": "FIAKeyTerms",
          "revision": "a39260670bba9d87d902e0fa0ae447341343481f"
        }
      },
