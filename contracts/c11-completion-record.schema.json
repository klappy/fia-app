{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fia.klappy.dev/contracts/c11-completion-record.schema.json",
  "title": "Completion record",
  "description": "Per pack, key fia.completion.v1.<packId>. A record is valid only while sourceDigest matches the current unit text; played and discussed are distinct.",
  "version": "1.0.0",
  "contract": "c11",
  "type": "object",
  "required": [
    "schemaVersion",
    "packId",
    "records"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "packId": {
      "type": "string",
      "pattern": "^[a-z]{3}(-[A-Za-z]{2,8})?\\.[1-3A-Z]{3}(-\\d{1,3}){2,4}$",
      "description": "<language>.<pericope>, e.g. spa.MRK-1-1-13"
    },
    "records": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "unitId",
          "sourceDigest",
          "manualOverride",
          "autoComplete",
          "playedParts"
        ],
        "additionalProperties": false,
        "properties": {
          "unitId": {
            "type": "string",
            "pattern": "^S0[1-6]-U\\d{3}$",
            "description": "guide unit id: step S01..S06, unit number zero-padded"
          },
          "sourceDigest": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$",
            "description": "SHA-256 hex, lower-case"
          },
          "manualOverride": {
            "type": [
              "boolean",
              "null"
            ]
          },
          "autoComplete": {
            "type": "boolean"
          },
          "discussed": {
            "type": "boolean"
          },
          "playedParts": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "enum": [
                "text",
                "terms",
                "description",
                "stop"
              ]
            }
          }
        }
      }
    }
  },
  "additionalProperties": false,
  "examples": [
    {
      "schemaVersion": 1,
      "packId": "eng.MRK-1-1-13",
      "records": [
        {
          "unitId": "S01-U001",
          "sourceDigest": "affdc8e569fa818aab90d16b1fc2f88f95efe409a4ef711e03a028420334d818",
          "manualOverride": null,
          "autoComplete": true,
          "discussed": false,
          "playedParts": [
            "text"
          ]
        }
      ]
    }
  ]
}
