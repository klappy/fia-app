{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fia.klappy.dev/contracts/c09-workspace.schema.json",
  "title": "Workspace persistence",
  "description": "One key per (pack, major version): fia.workspace.v1.<packId>. Payload = theme, view, guide position, resources filter, playback checkpoint, savedAt. Every field is validated against the loaded pack on restore; storage failure is a status, not an error; restore never autoplays.",
  "version": "1.0.0",
  "contract": "c09",
  "type": "object",
  "required": [
    "schemaVersion",
    "packId",
    "contentLanguage",
    "theme",
    "view",
    "position",
    "checkpoint",
    "savedAt"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "packId": {
      "type": "string",
      "pattern": "^[a-z]{3}(-[A-Za-z]{2,8})?\\.[1-3A-Z]{3}(-\\d{1,3}){2,4}$",
      "description": "<language>.<pericope>, e.g. spa.MRK-1-1-13"
    },
    "contentLanguage": {
      "type": "string",
      "pattern": "^[a-z]{3}(-[A-Za-z]{2,8})?$",
      "description": "Aquifer language code: ISO 639-3 three letters (eng, spa, arb, hin, ...) or Aquifer's script-suffixed forms (zhs, zht); never a BCP-47 two-letter tag"
    },
    "theme": {
      "type": "string",
      "enum": [
        "light",
        "dark"
      ]
    },
    "view": {
      "type": "string",
      "enum": [
        "guide",
        "scripture",
        "resources",
        "overview",
        "single-script"
      ]
    },
    "position": {
      "type": "object",
      "required": [
        "stepId",
        "unitId",
        "visited",
        "finished"
      ],
      "additionalProperties": false,
      "properties": {
        "stepId": {
          "type": "string",
          "pattern": "^S0[1-6]$"
        },
        "unitId": {
          "type": "string",
          "pattern": "^S0[1-6]-U\\d{3}$",
          "description": "guide unit id: step S01..S06, unit number zero-padded"
        },
        "edition": {
          "type": "string",
          "description": "Scripture edition id in this pack"
        },
        "visited": {
          "type": "array",
          "maxItems": 512,
          "items": {
            "type": "string",
            "pattern": "^S0[1-6]-U\\d{3}$",
            "description": "guide unit id: step S01..S06, unit number zero-padded"
          }
        },
        "finished": {
          "type": "boolean"
        },
        "attachedStopId": {
          "type": "string",
          "pattern": "^stop-\\d{3}$"
        }
      }
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "query": {
          "type": "string",
          "maxLength": 200
        },
        "filter": {
          "type": "string",
          "enum": [
            "all",
            "map",
            "image",
            "term",
            "video"
          ]
        },
        "selectedId": {
          "type": [
            "string",
            "null"
          ]
        },
        "collectionIds": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "string"
          }
        },
        "origin": {
          "type": "string",
          "enum": [
            "catalog",
            "guide"
          ]
        }
      }
    },
    "checkpoint": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/checkpoint"
        }
      ]
    },
    "sourceRevision": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$",
      "description": "SHA-256 hex, lower-case"
    },
    "savedAt": {
      "type": "string",
      "format": "date-time"
    }
  },
  "additionalProperties": false,
  "examples": [
    {
      "schemaVersion": 1,
      "packId": "eng.MRK-1-1-13",
      "contentLanguage": "eng",
      "theme": "dark",
      "view": "guide",
      "position": {
        "stepId": "S02",
        "unitId": "S02-U004",
        "edition": "BSB",
        "visited": [
          "S01-U001",
          "S02-U004"
        ],
        "finished": false
      },
      "resources": {
        "query": "",
        "filter": "all",
        "selectedId": null,
        "collectionIds": [],
        "origin": "catalog"
      },
      "checkpoint": {
        "ownerDomain": "guide",
        "clipId": "S02-U004",
        "recordingSource": "generated",
        "sourceSha256": "affdc8e569fa818aab90d16b1fc2f88f95efe409a4ef711e03a028420334d818",
        "outputSha256": "9287a51008bf6e9c94d8e12e1cbf1bd7abc3c9e985b808bfa23e15e6f19820a6",
        "offsetSeconds": 12.5,
        "phase": "unfinished"
      },
      "sourceRevision": "c1fe6f27e9738434c644c625acb6efaab9d2b89c01204babc0bd98643176fc0e",
      "savedAt": "2026-10-01T12:00:00Z"
    }
  ],
  "$defs": {
    "checkpoint": {
      "type": "object",
      "required": [
        "ownerDomain",
        "clipId",
        "recordingSource",
        "sourceSha256",
        "outputSha256",
        "offsetSeconds",
        "phase"
      ],
      "additionalProperties": false,
      "properties": {
        "ownerDomain": {
          "type": "string",
          "enum": [
            "guide",
            "scripture",
            "resources"
          ]
        },
        "clipId": {
          "type": "string"
        },
        "recordingSource": {
          "type": "string",
          "enum": [
            "source",
            "generated"
          ]
        },
        "sourceSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$",
          "description": "SHA-256 hex, lower-case"
        },
        "outputSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$",
          "description": "SHA-256 hex, lower-case"
        },
        "originalOutputSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$",
          "description": "SHA-256 hex, lower-case"
        },
        "offsetSeconds": {
          "type": "number",
          "minimum": 0,
          "maximum": 86400
        },
        "phase": {
          "type": "string",
          "enum": [
            "unfinished",
            "gap",
            "discussion-ended",
            "terminal-ended"
          ]
        },
        "nextClipId": {
          "type": "string"
        },
        "completionSectionId": {
          "type": "string",
          "pattern": "^S0[1-6]-U\\d{3}$",
          "description": "guide unit id: step S01..S06, unit number zero-padded"
        }
      }
    }
  }
}
