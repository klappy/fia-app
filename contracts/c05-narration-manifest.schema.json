{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fia.klappy.dev/contracts/c05-narration-manifest.schema.json",
  "title": "Narration manifest",
  "description": "Every clip binds a recording to the sha256 of the text it speaks. A clip may play only if sha256(text) === sourceSha256. Provider and voice are app-level labels; provider voice ids never appear (release audit C-14). Superseded clips stay addressable by hash.",
  "version": "1.0.0",
  "contract": "c05",
  "type": "object",
  "required": [
    "schemaVersion",
    "packId",
    "language",
    "entries"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "packId": {
      "type": "string",
      "pattern": "^[a-z]{3}(-[A-Za-z]{2,8})?\\.[1-3A-Z]{3}(-\\d{1,3}){2,4}$",
      "description": "<language>.<pericope>, e.g. spa.MRK-1-1-13"
    },
    "language": {
      "type": "string",
      "pattern": "^[a-z]{3}(-[A-Za-z]{2,8})?$",
      "description": "Aquifer language code: ISO 639-3 three letters (eng, spa, arb, hin, ...) or Aquifer's script-suffixed forms (zhs, zht); never a BCP-47 two-letter tag"
    },
    "entries": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/clip"
      }
    },
    "historicalEntries": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/clip"
      },
      "description": "superseded clips, kept addressable"
    }
  },
  "additionalProperties": false,
  "examples": [
    {
      "schemaVersion": 1,
      "packId": "eng.MRK-1-1-13",
      "language": "eng",
      "entries": [
        {
          "id": "S01-U001",
          "path": "/packs/eng.MRK-1-1-13/audio/S01-U001.opus",
          "bytes": 8962,
          "sha256": "9287a51008bf6e9c94d8e12e1cbf1bd7abc3c9e985b808bfa23e15e6f19820a6",
          "mime": "audio/ogg",
          "sourceSha256": "affdc8e569fa818aab90d16b1fc2f88f95efe409a4ef711e03a028420334d818",
          "recordingSource": "generated",
          "ai": true,
          "provider": "tts",
          "voice": "eng-narrator-1",
          "durationSeconds": 4.26,
          "provenance": {
            "status": "generated",
            "generatedFrom": "FIATranslationGuide@5d6d59a22caa8f8539c5ff6a3e1ec74c4cfa5c6d:eng/mark-1-1-13#S01-U001",
            "generator": "narration"
          }
        }
      ]
    }
  ],
  "$defs": {
    "clip": {
      "type": "object",
      "required": [
        "id",
        "path",
        "bytes",
        "sha256",
        "mime",
        "sourceSha256",
        "recordingSource",
        "ai",
        "provenance"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^(S0[1-6]-U\\d{3}|scripture-[A-Za-z0-9-]+|term-[a-z]{3}-[a-z0-9-]+|desc-[a-z0-9-]+|next-S0[1-6]-U\\d{3}|stop-\\d{3})$"
        },
        "path": {
          "type": "string",
          "pattern": "^/"
        },
        "bytes": {
          "type": "integer",
          "minimum": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$",
          "description": "SHA-256 hex, lower-case"
        },
        "mime": {
          "type": "string",
          "enum": [
            "audio/mpeg",
            "audio/ogg",
            "audio/mp4"
          ]
        },
        "sourceSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$",
          "description": "SHA-256 hex, lower-case"
        },
        "recordingSource": {
          "type": "string",
          "enum": [
            "source",
            "generated"
          ]
        },
        "ai": {
          "type": "boolean",
          "description": "true iff recordingSource is generated"
        },
        "provider": {
          "type": "string",
          "description": "opaque app label (e.g. tts, aquifer); never a hostname or key"
        },
        "voice": {
          "type": "string",
          "pattern": "^[a-z]{3}-[a-z0-9-]+$",
          "description": "app voice label <language>-<name>; never the provider's voice id"
        },
        "durationSeconds": {
          "type": "number",
          "minimum": 0
        },
        "sourceRecordId": {
          "type": "string"
        },
        "sourceRevision": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$",
          "description": "git commit sha (40 hex)"
        },
        "replaces": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$",
          "description": "SHA-256 hex, lower-case"
        },
        "provenance": {
          "$ref": "https://fia.klappy.dev/contracts/c06-provenance.schema.json"
        }
      }
    }
  }
}
