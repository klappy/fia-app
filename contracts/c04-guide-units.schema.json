{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fia.klappy.dev/contracts/c04-guide-units.schema.json",
  "title": "Guide unit and stop model",
  "description": "Stable unit ids derived from source structure, sha256 of each unit's text, explicit stop records attached to units, hidden regions flagged never deleted. Position, completion, narration and alignment all key on these ids.",
  "version": "1.0.0",
  "contract": "c04",
  "type": "object",
  "required": [
    "schemaVersion",
    "packId",
    "guideSha256",
    "steps",
    "stops"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "packId": {
      "type": "string",
      "pattern": "^[a-z]{3}(-[A-Za-z]{2,8})?\\.[1-3A-Z]{3}(-\\d{1,3}){2,4}$",
      "description": "<language>.<pericope>, e.g. spa.MRK-1-1-13"
    },
    "guideSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$",
      "description": "SHA-256 hex, lower-case"
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "units"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^S0[1-6]$"
          },
          "title": {
            "type": "string"
          },
          "units": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "id",
                "textSha256",
                "kind"
              ],
              "additionalProperties": false,
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^S0[1-6]-U\\d{3}$",
                  "description": "guide unit id: step S01..S06, unit number zero-padded"
                },
                "textSha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$",
                  "description": "SHA-256 hex, lower-case"
                },
                "kind": {
                  "type": "string",
                  "enum": [
                    "paragraph",
                    "list-item",
                    "heading",
                    "example"
                  ]
                },
                "hidden": {
                  "type": "boolean",
                  "default": false
                },
                "resources": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "description": "resource content ids referenced at this unit"
                },
                "provenance": {
                  "$ref": "https://fia.klappy.dev/contracts/c06-provenance.schema.json"
                }
              }
            }
          }
        }
      }
    },
    "stops": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "afterUnitId",
          "kind"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^stop-\\d{3}$"
          },
          "afterUnitId": {
            "type": "string",
            "pattern": "^S0[1-6]-U\\d{3}$",
            "description": "guide unit id: step S01..S06, unit number zero-padded"
          },
          "kind": {
            "type": "string",
            "enum": [
              "discussion",
              "activity",
              "terminal"
            ]
          },
          "promptSha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$",
            "description": "SHA-256 hex, lower-case"
          }
        }
      }
    }
  },
  "additionalProperties": false,
  "examples": [
    {
      "schemaVersion": 1,
      "packId": "eng.MRK-1-1-13",
      "guideSha256": "615c7efbcb52f913648f11b0314666bb535b4f07d39bae9df43c85eb7d379295",
      "steps": [
        {
          "id": "S01",
          "title": "Setting the scene",
          "units": [
            {
              "id": "S01-U001",
              "textSha256": "affdc8e569fa818aab90d16b1fc2f88f95efe409a4ef711e03a028420334d818",
              "kind": "paragraph"
            }
          ]
        }
      ],
      "stops": [
        {
          "id": "stop-001",
          "afterUnitId": "S01-U001",
          "kind": "discussion"
        }
      ]
    }
  ]
}
