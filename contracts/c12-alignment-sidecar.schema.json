{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fia.klappy.dev/contracts/c12-alignment-sidecar.schema.json",
  "title": "Alignment sidecar",
  "description": "Word/verse timing for one recording, bound to audioSha256 and sourceSha256. Times monotonic and within duration; character ranges cover the text; validator rejects otherwise. Timing is per recording hash, so a derivative needs its own sidecar or a proven offset.",
  "version": "1.0.0",
  "contract": "c12",
  "type": "object",
  "required": [
    "schemaVersion",
    "id",
    "audioSha256",
    "sourceSha256",
    "duration",
    "verses"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "type": "string"
    },
    "audioSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$",
      "description": "SHA-256 hex, lower-case"
    },
    "sourceSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$",
      "description": "SHA-256 hex, lower-case"
    },
    "duration": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "verses": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "sourceId",
          "text",
          "sourceHtmlSha256",
          "start",
          "end",
          "words"
        ],
        "additionalProperties": false,
        "properties": {
          "sourceId": {
            "type": "string"
          },
          "text": {
            "type": "string"
          },
          "sourceHtmlSha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$",
            "description": "SHA-256 hex, lower-case"
          },
          "start": {
            "type": "number",
            "minimum": 0
          },
          "end": {
            "type": "number",
            "minimum": 0
          },
          "words": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "from",
                "to",
                "start",
                "end"
              ],
              "additionalProperties": false,
              "properties": {
                "from": {
                  "type": "integer",
                  "minimum": 0
                },
                "to": {
                  "type": "integer",
                  "minimum": 0
                },
                "start": {
                  "type": "number",
                  "minimum": 0
                },
                "end": {
                  "type": "number",
                  "minimum": 0
                }
              }
            }
          }
        }
      }
    }
  },
  "additionalProperties": false,
  "examples": [
    {
      "schemaVersion": 1,
      "id": "scripture-BSB",
      "audioSha256": "9287a51008bf6e9c94d8e12e1cbf1bd7abc3c9e985b808bfa23e15e6f19820a6",
      "sourceSha256": "affdc8e569fa818aab90d16b1fc2f88f95efe409a4ef711e03a028420334d818",
      "duration": 52.1,
      "verses": [
        {
          "sourceId": "MRK-1-1",
          "text": "The beginning",
          "sourceHtmlSha256": "ac3a3c56a04d63ca0e322983e7a6865bca3d9e4da500df298756f10d3c934cb7",
          "start": 0.0,
          "end": 1.2,
          "words": [
            {
              "from": 0,
              "to": 3,
              "start": 0.0,
              "end": 0.4
            },
            {
              "from": 4,
              "to": 13,
              "start": 0.45,
              "end": 1.2
            }
          ]
        }
      ]
    }
  ]
}
