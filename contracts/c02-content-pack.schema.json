{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fia.klappy.dev/contracts/c02-content-pack.schema.json",
  "title": "Content-pack manifest",
  "description": "Per (language, pericope): the files of one pack, per tier, with bytes and sha256, the source revisions they came from and the rights pointer. Runtime re-verifies bytes+sha before use.",
  "version": "1.0.0",
  "contract": "c02",
  "type": "object",
  "required": [
    "schemaVersion",
    "packId",
    "language",
    "direction",
    "pericope",
    "sourceRevisions",
    "resourceTypes",
    "tiers",
    "rights"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "packId": {
      "type": "string",
      "pattern": "^[a-z]{3}(-[A-Za-z]{2,8})?\\.[1-3A-Z]{3}(-\\d{1,3}){2,4}$",
      "description": "<language>.<pericope>, e.g. spa.MRK-1-1-13"
    },
    "language": {
      "type": "string",
      "pattern": "^[a-z]{3}(-[A-Za-z]{2,8})?$",
      "description": "Aquifer language code: ISO 639-3 three letters (eng, spa, arb, hin, ...) or Aquifer's script-suffixed forms (zhs, zht); never a BCP-47 two-letter tag"
    },
    "autonym": {
      "type": "string",
      "minLength": 1,
      "description": "the language's own name for itself (e.g. English, Español), from LANGUAGE_INFO; shown in the language picker"
    },
    "direction": {
      "type": "string",
      "enum": [
        "ltr",
        "rtl"
      ]
    },
    "pericope": {
      "type": "string",
      "pattern": "^[1-3A-Z]{3}(-\\d{1,3}){2,4}$",
      "description": "USFM book id + chapter/verse range, e.g. MRK-1-1-13 (book, c, v[, c, v])"
    },
    "passage": {
      "type": "string",
      "description": "human reference, e.g. MRK 1:1-13"
    },
    "preparedAt": {
      "type": "string",
      "format": "date-time"
    },
    "sourceRevisions": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "string",
        "pattern": "^[a-f0-9]{40}$",
        "description": "git commit sha (40 hex)"
      },
      "description": "repo name -> commit sha (must equal the C-01 pins used)"
    },
    "resourceTypes": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "guide",
          "scripture",
          "term",
          "image",
          "map",
          "video",
          "audio",
          "description"
        ]
      }
    },
    "tiers": {
      "type": "object",
      "required": [
        "text"
      ],
      "additionalProperties": false,
      "properties": {
        "text": {
          "type": "object",
          "required": [
            "bytes",
            "files"
          ],
          "additionalProperties": false,
          "properties": {
            "bytes": {
              "type": "integer",
              "minimum": 0
            },
            "files": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/file"
              }
            }
          }
        },
        "phone": {
          "type": "object",
          "required": [
            "bytes",
            "files"
          ],
          "additionalProperties": false,
          "properties": {
            "bytes": {
              "type": "integer",
              "minimum": 0
            },
            "files": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/file"
              }
            }
          }
        },
        "medium": {
          "type": "object",
          "required": [
            "bytes",
            "files"
          ],
          "additionalProperties": false,
          "properties": {
            "bytes": {
              "type": "integer",
              "minimum": 0
            },
            "files": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/file"
              }
            }
          }
        },
        "original": {
          "type": "object",
          "required": [
            "bytes",
            "files"
          ],
          "additionalProperties": false,
          "properties": {
            "bytes": {
              "type": "integer",
              "minimum": 0
            },
            "files": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/file"
              }
            }
          }
        }
      }
    },
    "counts": {
      "type": "object",
      "additionalProperties": {
        "type": "integer",
        "minimum": 0
      }
    },
    "provenance": {
      "$ref": "https://fia.klappy.dev/contracts/c06-provenance.schema.json#/$defs/counts"
    },
    "rights": {
      "type": "array",
      "items": {
        "type": "string",
        "description": "C-13 rights record id"
      }
    }
  },
  "additionalProperties": false,
  "examples": [
    {
      "schemaVersion": 1,
      "packId": "eng.MRK-1-1-13",
      "language": "eng",
      "autonym": "English",
      "direction": "ltr",
      "pericope": "MRK-1-1-13",
      "passage": "MRK 1:1-13",
      "preparedAt": "2026-09-11T20:42:04.256Z",
      "sourceRevisions": {
        "FIATranslationGuide": "5d6d59a22caa8f8539c5ff6a3e1ec74c4cfa5c6d"
      },
      "resourceTypes": [
        "guide",
        "scripture",
        "term",
        "image",
        "map",
        "video"
      ],
      "tiers": {
        "text": {
          "bytes": 121233,
          "files": [
            {
              "path": "/packs/eng.MRK-1-1-13/guide.json",
              "bytes": 121233,
              "sha256": "615c7efbcb52f913648f11b0314666bb535b4f07d39bae9df43c85eb7d379295",
              "mime": "application/json"
            }
          ]
        }
      },
      "counts": {
        "steps": 6,
        "units": 117,
        "resources": 32,
        "scripture": 3,
        "stops": 39
      },
      "rights": [
        "FIATranslationGuide@5d6d59a"
      ]
    }
  ],
  "$defs": {
    "file": {
      "type": "object",
      "required": [
        "path",
        "bytes",
        "sha256",
        "mime"
      ],
      "additionalProperties": true,
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^/"
        },
        "bytes": {
          "type": "integer",
          "minimum": 0
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$",
          "description": "SHA-256 hex, lower-case"
        },
        "mime": {
          "type": "string",
          "pattern": "^[a-z]+/[a-z0-9.+-]+$"
        }
      }
    }
  }
}
