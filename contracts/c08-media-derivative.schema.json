{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fia.klappy.dev/contracts/c08-media-derivative.schema.json",
  "title": "Media derivative descriptor",
  "description": "A transcoded or downscaled variant of a source file. Accepted only if recipe is whitelisted and sourceSha256 matches; the original is always the fallback (R-306, R-511).",
  "version": "1.0.0",
  "contract": "c08",
  "type": "object",
  "required": [
    "sourcePath",
    "sourceSha256",
    "sourceBytes",
    "kind",
    "tier",
    "recipe",
    "mime",
    "bytes",
    "sha256",
    "eligible"
  ],
  "properties": {
    "sourcePath": {
      "type": "string",
      "pattern": "^/"
    },
    "sourceSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$",
      "description": "SHA-256 hex, lower-case"
    },
    "sourceBytes": {
      "type": "integer",
      "minimum": 1
    },
    "kind": {
      "type": "string",
      "enum": [
        "image",
        "audio"
      ]
    },
    "tier": {
      "type": "string",
      "enum": [
        "text",
        "phone",
        "medium",
        "original"
      ]
    },
    "recipe": {
      "type": "string",
      "enum": [
        "w=640,q=medium,f=webp",
        "w=1280,q=medium,f=webp",
        "a=opus,br=32k",
        "a=opus,br=64k",
        "a=aac,br=48k"
      ]
    },
    "mime": {
      "type": "string",
      "enum": [
        "image/webp",
        "audio/ogg",
        "audio/mp4"
      ]
    },
    "bytes": {
      "type": "integer",
      "minimum": 1
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$",
      "description": "SHA-256 hex, lower-case"
    },
    "width": {
      "type": "integer",
      "minimum": 1
    },
    "height": {
      "type": "integer",
      "minimum": 1
    },
    "durationSeconds": {
      "type": "number",
      "minimum": 0
    },
    "eligible": {
      "type": "boolean"
    },
    "fallbackMime": {
      "type": "string",
      "enum": [
        "audio/mpeg"
      ],
      "description": "iOS < 18.4 fallback for opus"
    }
  },
  "additionalProperties": false,
  "examples": [
    {
      "sourcePath": "/packs/eng.MRK-1-1-13/images/a111.jpg",
      "sourceSha256": "d314bac395b2aab8cf601f6a590bbf2547b71a54af67eb95dc927f5042883480",
      "sourceBytes": 69973,
      "kind": "image",
      "tier": "phone",
      "recipe": "w=640,q=medium,f=webp",
      "mime": "image/webp",
      "bytes": 33988,
      "sha256": "ba23d03249cbedc57aa38f981eff9f046a213b2d9b9762b04244f6d8db5275a3",
      "width": 640,
      "height": 360,
      "eligible": true
    }
  ]
}
