{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fia.klappy.dev/contracts/c10-settings.schema.json",
  "title": "Settings",
  "description": "Global, cross-pack preferences under one key fia.settings.v1. Enum values are the contract; UI labels are not.",
  "version": "1.1.0",
  "contract": "c10",
  "type": "object",
  "required": [
    "schemaVersion",
    "narrationMode",
    "mediaTier",
    "contentLanguage",
    "uiLanguage"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "narrationMode": {
      "$ref": "#/$defs/narrationMode"
    },
    "subtitleMode": {
      "type": "string",
      "enum": [
        "generated",
        "off"
      ],
      "default": "off",
      "description": "AI pericope subtitles on/off (1.1.0); default off (PoC a5); a missing key normalizes to the default"
    },
    "mediaTier": {
      "type": "string",
      "enum": [
        "text",
        "phone",
        "medium",
        "original"
      ]
    },
    "contentLanguage": {
      "type": "string",
      "pattern": "^[a-z]{3}(-[A-Za-z]{2,8})?$",
      "description": "Aquifer language code: ISO 639-3 three letters (eng, spa, arb, hin, ...) or Aquifer's script-suffixed forms (zhs, zht); never a BCP-47 two-letter tag"
    },
    "uiLanguage": {
      "type": "string",
      "pattern": "^[a-z]{3}(-[A-Za-z]{2,8})?$",
      "description": "Aquifer language code: ISO 639-3 three letters (eng, spa, arb, hin, ...) or Aquifer's script-suffixed forms (zhs, zht); never a BCP-47 two-letter tag"
    },
    "textSize": {
      "type": "string",
      "enum": [
        "system",
        "large",
        "max",
        "huge"
      ]
    },
    "lowLiteracy": {
      "type": "boolean"
    },
    "theme": {
      "type": "string",
      "enum": [
        "system",
        "light",
        "dark"
      ]
    },
    "disclosuresPresented": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "ai-narration",
          "ai-translation",
          "storage-eviction",
          "telemetry"
        ]
      }
    },
    "telemetryOptIn": {
      "type": "boolean",
      "default": false
    },
    "savedAt": {
      "type": "string",
      "format": "date-time"
    }
  },
  "additionalProperties": false,
  "examples": [
    {
      "schemaVersion": 1,
      "narrationMode": "source-fallback",
      "mediaTier": "phone",
      "contentLanguage": "spa",
      "uiLanguage": "spa",
      "textSize": "large",
      "lowLiteracy": false,
      "theme": "system",
      "disclosuresPresented": [
        "ai-narration"
      ],
      "telemetryOptIn": false,
      "savedAt": "2026-10-01T12:00:00Z"
    },
    {
      "schemaVersion": 1,
      "narrationMode": "source-fallback",
      "mediaTier": "phone",
      "contentLanguage": "spa",
      "uiLanguage": "spa",
      "textSize": "large",
      "lowLiteracy": false,
      "theme": "system",
      "disclosuresPresented": [
        "ai-narration"
      ],
      "telemetryOptIn": false,
      "savedAt": "2026-10-01T12:00:00Z",
      "subtitleMode": "generated"
    }
  ],
  "$defs": {
    "narrationMode": {
      "type": "string",
      "enum": [
        "source-fallback",
        "source-only",
        "generated-only"
      ],
      "description": "PoC aquifer-fallback|aquifer-only|ai-only, renamed to drop the backend name (R-313); default source-fallback (R-501)"
    }
  }
}
