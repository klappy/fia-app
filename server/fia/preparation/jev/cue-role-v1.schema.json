{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "FIA cue role v1 normalized decision",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract", "caseId", "roles", "needsReview", "evidenceUnitIds"],
  "properties": {
    "contract": {"const": "fia-cue-role@1"},
    "caseId": {"type": "string", "minLength": 1},
    "roles": {
      "type": "object",
      "additionalProperties": false,
      "required": ["readingRequested", "discussionRequested", "resourceLookupRequested", "pauseOnly"],
      "properties": {
        "readingRequested": {"type": "boolean"},
        "discussionRequested": {"type": "boolean"},
        "resourceLookupRequested": {"type": "boolean"},
        "pauseOnly": {"type": "boolean"}
      },
      "allOf": [{
        "if": {"properties": {"pauseOnly": {"const": true}}},
        "then": {"properties": {
          "readingRequested": {"const": false},
          "discussionRequested": {"const": false},
          "resourceLookupRequested": {"const": false}
        }}
      }]
    },
    "needsReview": {"type": "boolean"},
    "evidenceUnitIds": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
  }
}
