{
  "$meta": {
    "name": "fia-alpha-tokens",
    "version": "0.1.0-draft",
    "date": "2026-09-30",
    "kit": "bt-design-system-generative-glass@8d6b48d",
    "policy": "kit base ladders verbatim; alpha overrides semantic aliases only; all --fia-* names below; contrast computed WCAG 2.x, floors text 4.5, ui 3.0"
  },
  "color": {
    "ground": {
      "light": "#FFFFFF",
      "dark": "#0B0D10"
    },
    "surface-app": {
      "light": "#EEF0F5",
      "dark": "#0B0D10"
    },
    "surface-solid": {
      "light": "#FFFFFF",
      "dark": "#1B1E23"
    },
    "text-title": {
      "light": "#0E1420",
      "dark": "#FFFFFF",
      "contrast_on_ground": [18.43, 19.46]
    },
    "text-body": {
      "light": "#242C3A",
      "dark": "#E7EAEF",
      "contrast_on_ground": [14.03, 16.13],
      "contrast_on_surface": [12.31, 13.86]
    },
    "text-muted": {
      "light": "#5A6472",
      "dark": "#A7ADB6",
      "contrast_on_ground": [6.0, 8.61],
      "contrast_on_surface": [5.26, 7.4]
    },
    "text-heading-brand": {
      "light": "#415168",
      "dark": "#C3C9D6",
      "contrast_on_ground": [8.07, 12.9]
    },
    "primary": {
      "light": "#335374",
      "dark": "#9CC0E8",
      "contrast_vs_ground": [7.98, 10.3]
    },
    "on-primary": {
      "light": "#FFFFFF",
      "dark": "#0E1420",
      "contrast_on_primary": [7.98, 9.76]
    },
    "primary-pressed": {
      "light": "#264060",
      "dark": "#B6D2F0"
    },
    "primary-playing": {
      "light": "#3B6086",
      "dark": "#AECBEC"
    },
    "primary-disabled-border": {
      "light": "#8A9BAD",
      "dark": "#5C7A96",
      "note": "disabled = ground fill + 2px border + text-muted label; washed fill with white label (2.85:1) is banned"
    },
    "link": {
      "light": "#3B6086",
      "dark": "#9CC0E8",
      "contrast_on_ground": [6.56, 10.3]
    },
    "focus-ring": {
      "light": "#3B6086",
      "dark": "#9CC0E8",
      "contrast_vs_ground": [6.56, 10.3]
    },
    "prov-ai": {
      "light": "#5B3FA6",
      "dark": "#C9B8FF",
      "contrast_on_ground": [7.76, 10.92]
    },
    "prov-ai-tint": {
      "light": "#EFEAFB",
      "dark": "#2A2148",
      "text_on_tint": {
        "light": "#5B3FA6",
        "dark": "#D9CCFF"
      },
      "contrast_text_on_tint": [6.59, 9.95]
    },
    "prov-source": {
      "light": "#1E6B5E",
      "dark": "#7FD3C2",
      "contrast_on_ground": [6.33, 11.12]
    },
    "prov-source-tint": {
      "light": "#E3F4EF",
      "dark": "#123A33",
      "text_on_tint": {
        "light": "#1E6B5E",
        "dark": "#9FE3D4"
      },
      "contrast_text_on_tint": [5.56, 8.59]
    },
    "absent": {
      "light": "#5A6472",
      "dark": "#A7ADB6",
      "contrast_on_ground": [6.0, 8.61]
    },
    "absent-tint": {
      "light": "#E3E6ED",
      "dark": "#2A2E35",
      "text_on_tint": {
        "light": "#4B5563",
        "dark": "#C3C9D6"
      },
      "contrast_text_on_tint": [6.05, 8.21]
    },
    "stop": {
      "light": "#6B4A00",
      "dark": "#FFD98A"
    },
    "stop-band": {
      "light": "#FFF1D6",
      "dark": "#3A2E0F",
      "contrast_text_on_band": [7.22, 9.85]
    },
    "error": {
      "light": "#B3261E",
      "dark": "#FF8A80",
      "contrast_on_ground": [6.54, 8.52]
    },
    "error-tint": {
      "light": "#FDE7E5",
      "dark": "#4A1A16",
      "text_on_tint": {
        "light": "#8C1D17",
        "dark": "#FFB4AB"
      },
      "contrast_text_on_tint": [7.7, 8.53]
    },
    "offline-chip": {
      "light": "#E3E6ED",
      "dark": "#2A2E35",
      "text_on_chip": {
        "light": "#242C3A",
        "dark": "#E7EAEF"
      },
      "contrast_text_on_chip": [11.23, 11.3]
    },
    "rail-track": {
      "light": "#D6DAE4",
      "dark": "#2A2E35",
      "contrast_current_vs_track": [5.71, 7.22]
    },
    "pwa-theme-color": {
      "light": "#EEF0F5",
      "dark": "#0B0D10"
    }
  },
  "type": {
    "root_px": 16,
    "scale_steps": {
      "base": 1.0,
      "plus1": 1.15,
      "plus2": 1.3,
      "max": 1.5
    },
    "sizes_rem": {
      "hero": 1.75,
      "title": 1.375,
      "subtitle": 1.125,
      "body": 1.0625,
      "guide": 1.1875,
      "label": 0.9375,
      "caption": 0.8125,
      "micro": 0.75,
      "primary": 1.125,
      "scripture": 1.125
    },
    "weights": {
      "regular": 400,
      "medium": 500,
      "semibold": 600
    },
    "min_rendered_px": 12,
    "hide_at_steps": {
      "caption": ["plus2", "max"]
    },
    "fonts": {
      "latin": {
        "ui": "system-ui, -apple-system, 'Segoe UI', Roboto, 'Noto Sans', sans-serif",
        "scripture": "Georgia, 'Noto Serif', 'Times New Roman', serif",
        "lh": 1.5,
        "lh_scripture": 1.6,
        "langs": ["eng", "spa", "por", "fra", "ind", "swh", "tpi", "bis", "hau"]
      },
      "cyrillic": {
        "ui": "system-ui, -apple-system, 'Segoe UI', Roboto, 'Noto Sans', sans-serif",
        "scripture": "Georgia, 'Noto Serif', serif",
        "lh": 1.5,
        "lh_scripture": 1.6,
        "langs": ["rus"]
      },
      "devanagari": {
        "ui": "'Noto Sans Devanagari', 'Kohinoor Devanagari', Mangal, 'Nirmala UI', system-ui, sans-serif",
        "scripture": "'Noto Serif Devanagari', 'Kohinoor Devanagari', Mangal, serif",
        "lh": 1.7,
        "lh_scripture": 1.8,
        "langs": ["hin", "nep"]
      },
      "arabic": {
        "ui": "'Noto Naskh Arabic', 'Geeza Pro', 'Segoe UI', 'Noto Sans Arabic', system-ui, sans-serif",
        "scripture": "'Noto Naskh Arabic', 'Geeza Pro', 'Scheherazade New', serif",
        "lh": 1.8,
        "lh_scripture": 1.9,
        "dir": "rtl",
        "langs": ["arb", "fas", "apd"]
      },
      "cjk-sc": {
        "ui": "'PingFang SC', 'Noto Sans CJK SC', 'Noto Sans SC', 'Microsoft YaHei', system-ui, sans-serif",
        "scripture": "'Songti SC', 'Noto Serif CJK SC', serif",
        "lh": 1.75,
        "lh_scripture": 1.85,
        "langs": ["zhs"]
      },
      "cjk-tc": {
        "ui": "'PingFang TC', 'Noto Sans CJK TC', 'Noto Sans TC', 'Microsoft JhengHei', system-ui, sans-serif",
        "scripture": "'Songti TC', 'Noto Serif CJK TC', serif",
        "lh": 1.75,
        "lh_scripture": 1.85,
        "langs": ["zht"]
      }
    },
    "letter_spacing_non_latin": 0
  },
  "spacing": {
    "kit_ladder_px": [2, 4, 6, 8, 10, 12, 14, 16, 20, 24, 28, 32, 40, 48, 64],
    "gutter": 16,
    "gutter_wide": 18,
    "gap_stack": 12,
    "gap_inline": 8,
    "card_pad": 16,
    "card_pad_wide": 20,
    "dock_h": 64,
    "dock_h_stacked": 72,
    "safe_top": "env(safe-area-inset-top,0px)",
    "safe_bottom": "env(safe-area-inset-bottom,0px)",
    "content_max_width": 640
  },
  "radius": {
    "xs": 10,
    "sm": 14,
    "md": 18,
    "lg": 22,
    "xl": 28,
    "2xl": 34,
    "pill": 999,
    "primary": 18,
    "card": 28,
    "chip": 999,
    "sheet": 34
  },
  "elevation": {
    "shadow": "kit --shadow-rest/card/float per theme",
    "glass_fill": {
      "1": "rgba(255,255,255,.28)",
      "2": "rgba(255,255,255,.46)",
      "3": "rgba(255,255,255,.62)",
      "4": "rgba(255,255,255,.78)",
      "dark": {
        "1": "rgba(255,255,255,.05)",
        "2": "rgba(255,255,255,.09)",
        "3": "rgba(255,255,255,.14)",
        "4": "rgba(255,255,255,.20)"
      }
    },
    "blur_px": {
      "sheer": 8,
      "soft": 16,
      "medium": 24,
      "strong": 40
    },
    "usage": {
      "card": "fill2/soft",
      "dock": "fill3/strong",
      "sheet": "floating/medium",
      "primary": "solid, never glass",
      "text_min_fill": 2
    },
    "max_blurred_layers_phone": 2
  },
  "motion": {
    "dur_ms": {
      "micro": 140,
      "fast": 240,
      "base": 420,
      "slow": 680,
      "countdown": 750
    },
    "ease": {
      "liquid": "cubic-bezier(.22,1,.36,1)",
      "damp": "cubic-bezier(.4,0,.2,1)"
    },
    "press_scale": 0.972,
    "reduced_motion": "all durations 1ms; no float/drift/breathe; countdown ring becomes a static label tick; state never conveyed by motion alone"
  },
  "interaction": {
    "tap_min_px": 48,
    "tap_primary_px": 56,
    "tap_close_px": 56,
    "focus_ring": "3px solid focus-ring, offset 3px, :focus-visible",
    "long_press_ms": 500,
    "hover_only_affordances": false
  }
}
