art":6.599,"end":6.619},{"from":62,"to":64,"start":6.679,"end":6.759},{"from":65,"to":72,"start":6.839,"end":7.079},{"from":73,"to":75,"start":7.159,"end":7.219},{"from":76,"to":85,"start":7.319,"end":7.719},{"from":86,"to":92,"start":7.799,"end":8.079},{"from":93,"to":97,"start":8.159,"end":8.3},{"from":98,"to":103,"start":8.38,"end":8.699},{"from":104,"to":107,"start":9.079,"end":9.159},{"from":108,"to":112,"start":9.22,"end":9.34},{"from":113,"to":120,"start":9.399,"end":9.739},{"from":121,"to":125,"start":9.819,"end":9.96},{"from":126,"to":130,"start":10.039,"end":10.279}]},{"sourceId":"10041001003","verse":3,"start":10.76,"end":16.399,"text":"a voice of one calling out in the wilderness, ‘Make ready the way of the Lord; make his paths straight.’”","sourceHtmlSha256":"02e57242dc9c8e047d4a61e54c8cba928b58cd06f347b31f026e60c80bd140ee","words":[{"from":0,"to":1,"start":10.76,"end":10.8},{"from":2,"to":7,"start":10.88,"end":11.119},{"from":8,"to":10,"start":11.179,"end":11.259},{"from":11,"to":14,"start":11.38,"end":11.5},{"from":15,"to":22,"start":11.599,"end":11.88},{"from":23,"to":26,"start":11.96,"end":12.099},{"from":27,"to":29,"start":12.159,"end":12.239},{"from":30,"to":33,"start":12.3,"end":12.34},{"from":34,"to":45,"start":12.42,"end":12.96},{"from":46,"to":51,"start":13.38,"end":13.599},{"from":52,"to":57,"start":13.699,"end":13.92},{"from":58,"to":61,"start":14,"end":14.039},{"from":62,"to":65,"start":14.139,"end":14.319},{"from":66,"to":68,"start":14.38,"end":14.439},{"from":69,"to":72,"start":14.5,"end":14.539},{"from":73,"to":78,"start":14.639,"end":14.899},{"from":79,"to":83,"start":15,"end":15.139},{"from":84,"to":87,"start":15.199,"end":15.319},{"from":88,"to":93,"start":15.42,"end":15.799},{"from":94,"to":105,"start":15.979,"end":16.399}]},{"sourceId":"10041001004","verse":4,"start":17.119,"end":22.959,"text":"John came, the one baptizing in the wilderness and preaching a baptism of repentance for forgiveness of sins.","sourceHtmlSha256":"b08bfc0f3