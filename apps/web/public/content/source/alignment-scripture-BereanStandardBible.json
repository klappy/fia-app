19},{"from":19,"to":25,"start":39.759,"end":40.079},{"from":26,"to":28,"start":40.139,"end":40.259},{"from":29,"to":33,"start":40.319,"end":40.479},{"from":34,"to":38,"start":40.54,"end":40.759},{"from":39,"to":42,"start":40.879,"end":41},{"from":43,"to":47,"start":41.059,"end":41.219},{"from":48,"to":56,"start":41.299,"end":41.739},{"from":57,"to":61,"start":41.779,"end":41.899},{"from":62,"to":64,"start":42.139,"end":42.2},{"from":65,"to":68,"start":42.259,"end":42.36},{"from":69,"to":75,"start":42.399,"end":42.86},{"from":76,"to":78,"start":42.939,"end":43.02},{"from":79,"to":84,"start":43.059,"end":43.259},{"from":85,"to":92,"start":43.319,"end":43.779},{"from":93,"to":94,"start":43.86,"end":43.899},{"from":95,"to":97,"start":43.939,"end":44.04},{"from":98,"to":101,"start":44.079,"end":44.219},{"from":102,"to":108,"start":44.299,"end":44.579},{"from":109,"to":111,"start":44.619,"end":44.719},{"from":112,"to":117,"start":44.799,"end":45.039},{"from":118,"to":122,"start":45.099,"end":45.319},{"from":123,"to":126,"start":45.36,"end":45.479},{"from":127,"to":133,"start":45.52,"end":46.099}]},{"sourceId":"10041001008","verse":8,"start":46.599,"end":50.059,"text":"I baptize you with water, but He will baptize you with the Holy Spirit.”","sourceHtmlSha256":"c31abba04f5cc4f900dafe72740385648ea1a355e3168275e37a1603723ac1c0","words":[{"from":0,"to":1,"start":46.599,"end":46.68},{"from":2,"to":9,"start":46.739,"end":47.239},{"from":10,"to":13,"start":47.279,"end":47.36},{"from":14,"to":18,"start":47.399,"end":47.52},{"from":19,"to":25,"start":47.619,"end":47.879},{"from":26,"to":29,"start":47.939,"end":48.02},{"from":30,"to":32,"start":48.099,"end":48.18},{"from":33,"to":37,"start":48.219,"end":48.319},{"from":38,"to":45,"start":48.379,"end":48.879},{"from":46,"to":49,"start":48.919,"end":49},{"from":50,"to":54,"start":49.039,"end":49.139},{"from":55,"to":58,"start":49.2,"end":49.259},{"from":59,"to":63,"start":49.34,"end":49.539},{"from":64,"to":72,"start":49.639,"end":50